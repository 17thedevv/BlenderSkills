+            (root/'DELIVERY.md').write_text('<!-- PROJECT_STATE_BEGIN -->\n```json\n'+json.dumps(block)+'\n```\n<!-- PROJECT_STATE_END -->\n[broken](missing.png)')
+            errors,_=m.validate(root,state)
+            self.assertTrue(any('broken' in e for e in errors))
